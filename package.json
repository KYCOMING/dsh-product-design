{
  "name": "dsh-product-design",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A simplified Figma-style product design canvas in the sidebar: compose interactive prototypes and preview component and page states.",
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "product-design",
    "figma",
    "canvas",
    "prototype"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "host-model.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20",
    "dsh": ">=0.1.6"
  },
  "peerDependencies": {
    "react": "^18.2.0"
  },
  "scripts": {
    "syntax": "node --check client.js && node --check index.js && node --check host-model.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check test vitest.config.mjs",
    "format": "biome format --write test vitest.config.mjs",
    "check": "pnpm run syntax && pnpm run lint && pnpm run test"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "jsdom": "^25.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vitest": "^4.1.11"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-commands"
      ]
    }
  }
}
