{
  "name": "dsh-product-design",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "A simplified Figma-style product design canvas in the sidebar: compose interactive prototypes and preview component and page states.",
  "license": "MIT",
  "author": "KYCOMING",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KYCOMING/dsh-product-design.git"
  },
  "homepage": "https://github.com/KYCOMING/dsh-product-design#readme",
  "bugs": {
    "url": "https://github.com/KYCOMING/dsh-product-design/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "product-design",
    "figma",
    "canvas",
    "prototype"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "src",
    "README.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.0-rc.1 <0.3.0-0"
  },
  "peerDependencies": {
    "react": "^18.2.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "pretest": "node scripts/build.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "syntax": "node --check client.js && node --check index.js",
    "lint": "biome check src scripts test vitest.config.mjs",
    "format": "biome format --write src scripts test vitest.config.mjs",
    "check": "node scripts/build.mjs && node --check client.js && node --check index.js && biome check src scripts test vitest.config.mjs && vitest run",
    "prepack": "node scripts/build.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "esbuild": "^0.28.2",
    "jsdom": "^25.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vitest": "^4.1.11"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
